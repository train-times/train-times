{
  "name": "train-times",
  "version": "0.0.4",
  "license": "MIT",
  "author": "gameroman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/train-times/train-times.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#api": "./src/api/index.ts",
    "#api/*": "./src/api/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "fixture": "bun run ./scripts/generate-fixture",
